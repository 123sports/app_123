# Browser-safe Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Never enable this in a deployed environment. The local preview script sets it automatically.
VITE_ENABLE_LOCAL_MODE=false

# Server-only Supabase configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Prefer the current sb_secret_ key. The legacy service_role key remains supported.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only payment configuration for the future Mercado Pago adapter
PAYMENT_PROVIDER=local
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
