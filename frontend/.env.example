# Browser-safe Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Never enable this in a deployed environment. The local preview script sets it automatically.
VITE_ENABLE_LOCAL_MODE=false
VITE_ENABLE_GOOGLE_AUTH=false
# Use "local" only for localhost simulations. Production must use "mercado_pago".
VITE_PAYMENT_PROVIDER=local

# Server-only Supabase configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Prefer the current sb_secret_ key. The legacy service_role key remains supported.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Mercado Pago configuration. Never prefix these with VITE_.
PAYMENT_PROVIDER=local
ALLOW_LOCAL_PAYMENT_SIMULATION=true
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_ENVIRONMENT=production
ENABLE_TEST_BOOKING_TYPE=false
VITE_ENABLE_TEST_BOOKING_TYPE=false
APP_BASE_URL=http://127.0.0.1:4173
